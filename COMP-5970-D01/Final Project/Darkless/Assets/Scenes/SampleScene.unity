  m_EditorClassIdentifier: Assembly-CSharp::MainMenu
  titleText: DARKLESS
  taglineText: "Stranded after dark. Find the key that starts your car \u2014 and
    survive the night."
  howToText: "GATHER by day, SURVIVE the night.\n\u2022 Keep your CAMPFIRE fed (E)
    \u2014 light keeps the dark thing away.\n\u2022 SEARCH the creatures at night
    for car keys \u2014 only one fits.\n\u2022 Make TORCHES at your pack (5 sticks);
    FLASHLIGHT (F) is your panic button.\n\u2022 Bring a key to the CAR and try it.
    Escape before the nights get deadly."
  showAtStart: 1
  menuCamera: {fileID: 0}
  dimColor: {r: 0, g: 0, b: 0, a: 0.92}
